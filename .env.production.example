# ============================================================================
# PRODUCTION ENVIRONMENT — TEMPLATE ONLY
# ============================================================================
# Copy to `.env.production` on the production host and fill in the values.
# NEVER commit the real `.env.production`; it is ignored by git.
# No real secrets appear in this file. All secrets are placeholders.
# ============================================================================

# ── PostgreSQL (used by the production Postgres container) ──────────
# Strong random values. Generate with:  openssl rand -hex 16
POSTGRES_USER=CHANGE_ME_DB_USER
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=bazar_survey

# ── Server ─────────────────────────────────────────────────────────
# production | staging
NODE_ENV=production
# Port the backend listens on inside its container.
PORT=4000
# PostgreSQL connection string for the production database.
# Host `postgres` is the compose service name (resolves on the internal
# network); the password must match POSTGRES_PASSWORD above.
DATABASE_URL=postgres://CHANGE_ME_DB_USER:CHANGE_ME_DB_PASSWORD@postgres:5432/bazar_survey

# ── Session / Security ─────────────────────────────────────────────
# Generate with:  openssl rand -hex 32   (64 hex chars)
SESSION_SECRET=CHANGE_ME_SESSION_SECRET
# Behind HTTPS only: set to true. The reverse proxy terminates TLS.
COOKIE_SECURE=true
# Comma separated list of allowed browser origins (the public frontend origin).
# e.g. https://survey.example.com
CORS_ORIGIN=https://CHANGE_ME_PUBLIC_ORIGIN

# ── Import / GIS ───────────────────────────────────────────────────
# Maximum accepted GeoJSON upload size (characters).
MAX_GEOJSON_SIZE=50000000
# EPSG code of the source GeoJSON files (32638 = UTM zone 38N for Tabriz).
SOURCE_EPSG=32638
# Maximum size of a downloaded GIS reference layer (bytes).
GIS_SOURCE_MAX_BYTES=250000000

# ── GitHub synchronization (optional backup) ───────────────────────
# Production deployment does NOT require GitHub sync. Leave these empty to
# disable it. If you ever enable it, put the token in the environment of the
# backend container, never in a tracked file.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPOSITORY=
GITHUB_FILE_PATH=bazar_tabriz_survey.json
GITHUB_SYNC_INTERVAL=0