# ── Server ─────────────────────────────────────────────────────────
PORT=4000
# PostgreSQL connection string
DATABASE_URL=postgres://survey:survey@localhost:5432/bazar_survey

# ── Session / Security ─────────────────────────────────────────────
# Long random string used to sign session cookies. CHANGE THIS in production.
SESSION_SECRET=dev-session-secret-change-me
# Enable the "Secure" flag on the session cookie only behind HTTPS.
COOKIE_SECURE=false
# Comma separated list of allowed browser origins (CORS). Dev only.
CORS_ORIGIN=http://localhost:5173

# ── Import / GIS ───────────────────────────────────────────────────
# Maximum accepted GeoJSON upload size (characters)
MAX_GEOJSON_SIZE=50000000
# Distance (meters) used to decide that an entity with the same AutoCAD handle
# is the SAME shop after a geometry update.
SHOP_MATCH_DISTANCE=15
# Distance threshold (meters) for showing a warning to the surveyor.
GPS_WARNING_DISTANCE=30
# EPSG code of the source GeoJSON files (738 = WGS84, 32638 = UTM zone 38N)
SOURCE_EPSG=32638

# ── GitHub synchronization (optional backup) ───────────────────────
# GitHub "fine-grained" or classic token with contents:write access.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPOSITORY=
# Path inside the repository where the GeoJSON backup is stored.
GITHUB_FILE_PATH=bazar_tabriz_survey.json
# Sync automatically after every N successful surveys. Set to 0 to disable auto-sync.
GITHUB_SYNC_INTERVAL=20